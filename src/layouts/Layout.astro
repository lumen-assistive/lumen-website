---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';

interface Props {
  title: string;
  description: string;
  lang: 'it' | 'en';
  altHref: string;
}

const { title, description, lang, altHref } = Astro.props;

const nav =
  lang === 'it'
    ? [
        { href: '/', label: 'Home' },
        { href: '/moduli/', label: 'Moduli' },
        { href: '/privacy/', label: 'Privacy' },
        { href: '/sdk/', label: 'SDK' },
        { href: '/download/', label: 'Download' },
        { href: '/docs/', label: 'Docs' },
      ]
    : [
        { href: '/en/', label: 'Home' },
        { href: '/en/modules/', label: 'Modules' },
        { href: '/en/privacy/', label: 'Privacy' },
        { href: '/en/sdk/', label: 'SDK' },
        { href: '/en/download/', label: 'Download' },
        { href: '/docs/', label: 'Docs' },
      ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Lumen</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'it' ? 'Vai al contenuto' : 'Skip to content'}</a>
    <header>
      <div class="bar">
        <a class="brand" href={lang === 'it' ? '/' : '/en/'}>
          <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
            <path d="M 33.2 10.9 A 16 16 0 1 1 14.8 10.9" />
          </svg>
          Lumen
        </a>
        <nav aria-label={lang === 'it' ? 'Navigazione principale' : 'Main navigation'}>
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <a class="lang-toggle" href={altHref} hreflang={lang === 'it' ? 'en' : 'it'}>
          {lang === 'it' ? 'English' : 'Italiano'}
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <p>
          {lang === 'it'
            ? 'Progetto open source per il GF Marilli Prize di HackersGen.'
            : 'An open source project for the GF Marilli Prize by HackersGen.'}
        </p>
        <p><a href="https://github.com/lumen-assistive">github.com/lumen-assistive</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --paper: #fdfbf5;
    --paper-dim: #f1ece0;
    --ink: #1c1a16;
    --muted: #6b655a;
    --lumen: #8f5c13;
    --border: #e3ddcc;
    --max: 46rem;
    --max-wide: 58rem;
    --font: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #19170f;
      --paper-dim: #231f16;
      --ink: #f3efe2;
      --muted: #b7ae99;
      --lumen: #e3a94a;
      --border: #3a3424;
    }
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--lumen);
    color: var(--paper);
    padding: 0.75rem 1rem;
    z-index: 10;
    font-weight: 700;
  }

  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  header {
    border-bottom: 1px solid var(--border);
  }

  .bar {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    fill: none;
    stroke: var(--lumen);
    stroke-width: 6;
    stroke-linecap: round;
  }

  nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-left: auto;
  }

  nav a,
  .lang-toggle {
    color: var(--muted);
    text-decoration: none;
    padding: 0.5rem 0.1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--ink);
  }

  .lang-toggle {
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.4rem 0.85rem;
    color: var(--ink);
  }

  .lang-toggle:hover,
  .lang-toggle:focus-visible {
    border-color: var(--lumen);
  }

  a {
    color: var(--ink);
    text-decoration-color: var(--lumen);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }

  a:hover,
  a:focus-visible {
    color: var(--lumen);
  }

  :focus-visible {
    outline: 3px solid var(--lumen);
    outline-offset: 2px;
  }

  main {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    max-width: var(--max);
    padding: 4rem 0 3rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .lead {
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--ink);
    max-width: 38ch;
    margin: 0 0 2rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.7rem 1.4rem;
    border-radius: 0.3rem;
    font-weight: 700;
    text-decoration: none;
  }

  .button.primary {
    background: var(--lumen);
    color: var(--paper);
  }

  .button.primary:hover,
  .button.primary:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .button.secondary {
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    border-color: var(--lumen);
    color: var(--lumen);
  }

  section {
    max-width: var(--max);
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }

  section.wide {
    max-width: var(--max-wide);
  }

  h2 {
    font-size: 1.9rem;
    margin: 0 0 1.25rem;
  }

  h3 {
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }

  p {
    margin: 0 0 1.2rem;
  }

  .notice {
    border-left: 3px solid var(--lumen);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--paper-dim);
  }

  .module-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .module-list li {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .module-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .module-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .module-head h3 {
    margin: 0;
  }

  .status {
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .status.available {
    color: var(--lumen);
  }

  .status.planned {
    color: var(--muted);
  }

  footer {
    border-top: 1px solid var(--border);
    margin-top: 2rem;
  }

  .footer-inner {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .footer-inner p {
    margin: 0 0 0.3rem;
  }
</style>
