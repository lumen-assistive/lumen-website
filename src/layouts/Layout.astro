---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  { href: '/modules/', label: 'Modules' },
  { href: '/demo/', label: 'Demo' },
  { href: '/screenshots/', label: 'Screenshots' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/sdk/', label: 'SDK' },
  { href: '/download/', label: 'Download' },
  { href: '/docs/', label: 'Docs' },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname === href || pathname.startsWith(href);
const fullTitle = title === 'Lumen' ? 'Lumen - A little light, when it\'s needed' : `${title} - Lumen`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0b08" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumen" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">
          <svg class="mark draw-in" viewBox="0 0 48 48" aria-hidden="true">
            <path d="M 33.2 10.9 A 16 16 0 1 1 14.8 10.9" />
          </svg>
          Lumen
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="nav-toggle-label">Menu</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a class="button primary nav-cta" href="https://github.com/lumen-assistive">GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href="/">
              <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
                <path d="M 33.2 10.9 A 16 16 0 1 1 14.8 10.9" />
              </svg>
              Lumen
            </a>
            <p>An open source, offline-first, privacy-by-design assistant for people with a limitation. Built for the GF Marilli Prize by HackersGen.</p>
          </div>

          <nav class="footer-col" aria-label="Product">
            <h2>Product</h2>
            <a href="/">Home</a>
            <a href="/modules/">Modules</a>
            <a href="/demo/">Demo</a>
            <a href="/screenshots/">Screenshots</a>
            <a href="/download/">Download</a>
          </nav>

          <nav class="footer-col" aria-label="Developers">
            <h2>Developers</h2>
            <a href="/sdk/">SDK</a>
            <a href="/docs/">Documentation</a>
            <a href="/docs/contributing/plugins/">Build a plugin</a>
            <a href="https://github.com/lumen-assistive/lumen-plugins">Plugins on GitHub</a>
            <a href="https://github.com/lumen-assistive">GitHub organization</a>
          </nav>

          <nav class="footer-col" aria-label="Project">
            <h2>Project</h2>
            <a href="/privacy/">Privacy</a>
            <a href="/docs/introduction/status/">Project status</a>
            <a href="/docs/reference/faq/">FAQ</a>
            <a href="https://github.com/lumen-assistive/lumen-website/blob/main/CONTRIBUTING.md">Contributing</a>
            <a href="https://github.com/lumen-assistive/lumen-website/blob/main/CODE_OF_CONDUCT.md">Code of conduct</a>
            <a href="https://github.com/lumen-assistive/lumen-website/blob/main/SECURITY.md">Security</a>
          </nav>
        </div>

        <div class="footer-bottom">
          <p>Licensed under the Apache License 2.0.</p>
          <p><a href="https://github.com/lumen-assistive">github.com/lumen-assistive</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  (function () {
    var toggle = document.querySelector('.nav-toggle');
    var nav = document.getElementById('site-nav');
    if (!toggle || !nav) return;
    var setOpen = function (open) {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      nav.classList.toggle('open', open);
    };
    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>

<script is:inline>
  (function () {
    var sections = document.querySelectorAll('main section');
    if (!sections.length) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    sections.forEach(function (section) {
      section.classList.add('reveal');
    });

    if (reduceMotion || typeof IntersectionObserver === 'undefined') {
      sections.forEach(function (section) {
        section.classList.add('revealed');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
    );

    sections.forEach(function (section) {
      observer.observe(section);
    });
  })();
</script>

<style is:global>
  :root {
    color-scheme: dark;
    /* Dark, glowing identity: Lumen means light, so the glow is warm gold,
       not the cool blue sometimes used for this kind of hero treatment.
       This is the site's one real look now, not a prefers-color-scheme
       variant of a lighter default. */
    --paper: #0d0b08;
    --paper-dim: #17140f;
    --ink: #f3efe2;
    --muted: #b7ae99;
    --lumen: #e3a94a;
    --glow: #f5b942;
    --border: #3a3424;
    --max: 46rem;
    --max-wide: 58rem;
    --font: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--lumen);
    color: var(--paper);
    padding: 0.75rem 1rem;
    z-index: 10;
    font-weight: 700;
  }

  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .bar {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    fill: none;
    stroke: var(--lumen);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .mark.draw-in path {
    stroke-dasharray: 80;
    stroke-dashoffset: 80;
    animation: mark-draw 900ms ease-out 150ms forwards;
  }

  @keyframes mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark.draw-in path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    flex-wrap: wrap;
    margin-left: auto;
  }

  .site-nav a:not(.button) {
    position: relative;
    color: var(--muted);
    text-decoration: none;
    padding: 0.5rem 0.1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 1rem;
    transition: color 150ms ease;
  }

  .site-nav a:not(.button)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--lumen);
    transform: scaleX(0);
    transition: transform 200ms ease;
  }

  .site-nav a:not(.button):hover,
  .site-nav a:not(.button):focus-visible,
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .site-nav a:not(.button):hover::after,
  .site-nav a:not(.button):focus-visible::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-cta {
    min-height: 40px !important;
    padding: 0.35rem 1.1rem !important;
    font-size: 0.95rem;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--paper-dim);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .nav-toggle svg {
    width: 1.2rem;
    height: 1.2rem;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  @media (max-width: 860px) {
    .js .nav-toggle {
      display: inline-flex;
    }

    .js .site-nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0.5rem 0 0.5rem;
      padding: 0.5rem 0 0.25rem;
      border-top: 1px solid var(--border);
    }

    .js .site-nav.open {
      display: flex;
    }

    .js .site-nav a:not(.button) {
      padding: 0.6rem 0.25rem;
      font-size: 1.1rem;
    }

    .js .site-nav a:not(.button)::after {
      display: none;
    }

    .js .site-nav .nav-cta {
      margin-top: 0.75rem;
      justify-content: center;
    }
  }

  a {
    color: var(--ink);
    text-decoration-color: var(--lumen);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
    transition: color 150ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--lumen);
  }

  :focus-visible {
    outline: 3px solid var(--lumen);
    outline-offset: 2px;
  }

  main {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    position: relative;
    max-width: var(--max-wide);
    padding: 5rem 0 3.5rem;
    overflow: visible;
  }

  .hero-glow {
    position: absolute;
    top: -6rem;
    left: 50%;
    width: 46rem;
    height: 46rem;
    max-width: 150vw;
    transform: translateX(-50%);
    background: radial-gradient(circle, var(--glow) 0%, rgba(245, 185, 66, 0.35) 28%, transparent 68%);
    filter: blur(38px);
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .hero h1 {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: clamp(3.2rem, 10vw, 6.4rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin: 0 auto 1.5rem;
    max-width: 24ch;
  }

  .hero .lead,
  .hero .cta-row {
    position: relative;
    z-index: 1;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .hero .cta-row {
    justify-content: center;
  }

  .lead {
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--ink);
    max-width: 38ch;
    margin: 0 0 2rem;
  }

  .hero-enter {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-enter 650ms ease-out forwards;
  }

  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
      animation: none;
    }

  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 550ms ease, transform 550ms ease;
  }

  .reveal.revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.7rem 1.6rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button:active {
    transform: translateY(0);
  }

  .button.primary {
    background: var(--lumen);
    color: var(--paper);
  }

  .button.primary:hover,
  .button.primary:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .button.secondary {
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    border-color: var(--lumen);
    color: var(--lumen);
  }

  @media (prefers-reduced-motion: reduce) {
    .button:hover,
    .button:focus-visible,
    .button:active {
      transform: none;
    }
  }

  section {
    max-width: var(--max);
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }

  section.wide {
    max-width: var(--max-wide);
  }

  h2 {
    font-size: 1.9rem;
    margin: 0 0 1.25rem;
  }

  h3 {
    font-size: 1.3rem;
    line-height: 1.25;
    margin: 0 0 0.4rem;
  }

  p {
    margin: 0 0 1.2rem;
  }

  .notice {
    border-left: 3px solid var(--lumen);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--paper-dim);
  }

  .module-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .module-list li {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .module-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .module-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .module-head h3 {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .module-icon {
    flex-shrink: 0;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--module-color, var(--lumen)) 16%, var(--paper-dim));
    color: var(--module-color, var(--lumen));
  }

  .module-icon svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .status {
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .status.available {
    color: var(--lumen);
  }

  .status.planned {
    color: var(--muted);
  }

  .demo-block {
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--paper-dim);
  }

  .demo-block label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .demo-block textarea,
  .demo-block input[type='number'] {
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.6rem 0.75rem;
    width: 100%;
    box-sizing: border-box;
  }

  .demo-block textarea {
    min-height: 5rem;
    resize: vertical;
    margin-bottom: 0.75rem;
  }

  .demo-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .demo-row label {
    margin-bottom: 0.2rem;
  }

  .demo-row input[type='number'] {
    width: 6rem;
  }

  .demo-output {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--lumen);
    background: var(--paper);
    min-height: 1.5rem;
    white-space: pre-wrap;
  }

  .color-swatch {
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    border: 1px solid var(--border);
    border-radius: 0.2em;
    vertical-align: middle;
    margin-right: 0.5em;
  }

  footer {
    border-top: 1px solid var(--border);
    margin-top: 2rem;
    background: var(--paper-dim);
  }

  .footer-inner {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .footer-brand p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.85rem 0 0;
    max-width: 30ch;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col h2 {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0 0 0.2rem;
  }

  .footer-col a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--lumen);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom a {
    color: var(--muted);
    text-decoration-color: var(--lumen);
  }

  .footer-bottom a:hover,
  .footer-bottom a:focus-visible {
    color: var(--lumen);
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  .phone-demo {
    display: flex;
    justify-content: center;
    padding: 1rem 0 3rem;
  }

  .phone {
    position: relative;
    width: min(360px, 100%);
    background: var(--ink);
    border-radius: 2.5rem;
    padding: 0.65rem;
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.3), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .phone-side-button {
    position: absolute;
    background: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .phone-side-power {
    right: -0.15rem;
    top: 7.5rem;
    width: 0.15rem;
    height: 3.5rem;
    border-radius: 0 0.15rem 0.15rem 0;
  }

  .phone-side-volume-up {
    left: -0.15rem;
    top: 6rem;
    width: 0.15rem;
    height: 2.25rem;
    border-radius: 0.15rem 0 0 0.15rem;
  }

  .phone-side-volume-down {
    left: -0.15rem;
    top: 9rem;
    width: 0.15rem;
    height: 2.25rem;
    border-radius: 0.15rem 0 0 0.15rem;
  }

  .phone-notch {
    position: absolute;
    top: 0.65rem;
    left: 50%;
    transform: translateX(-50%);
    width: 6.5rem;
    height: 1.4rem;
    background: var(--ink);
    border-radius: 0 0 1rem 1rem;
    z-index: 2;
  }

  .phone-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.5rem 0.2rem;
    color: var(--paper);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .phone-statusbar-icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .phone-screen {
    position: relative;
    background: var(--paper);
    border-radius: 1.85rem;
    overflow: hidden;
    height: 600px;
    display: flex;
    flex-direction: column;
  }

  .phone-app-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem 0.9rem;
    font-weight: 700;
    font-size: 1.1rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .phone-app-header .phone-mark {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--lumen);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .phone-view {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem 1.5rem;
  }

  .phone-view:not([hidden]) {
    animation: phone-view-in 260ms ease;
  }

  @keyframes phone-view-in {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-view:not([hidden]) {
      animation: none;
    }
  }

  .phone-view-title {
    font-weight: 700;
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
  }

  .phone-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.65rem 0.4rem;
    border: none;
    border-bottom: 1px solid var(--border);
    background: none;
    text-align: left;
    font: inherit;
    color: var(--ink);
    cursor: pointer;
    min-height: 48px;
    transition: background-color 150ms ease;
  }

  .phone-row:first-of-type {
    border-top: 1px solid var(--border);
  }

  .phone-row:hover,
  .phone-row:focus-visible {
    background: var(--paper-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-row-icon,
    .phone-row {
      transition: none;
    }

    .phone-row:hover .phone-row-icon {
      transform: none;
    }
  }

  .phone-row:active {
    transform: scale(0.99);
  }

  .phone-row-icon {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--module-color, var(--lumen)) 16%, var(--paper-dim));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--module-color, var(--lumen));
    transition: transform 180ms ease;
  }

  .phone-row:hover .phone-row-icon {
    transform: scale(1.08);
  }

  .phone-module-title {
    position: relative;
    padding-left: 0.9rem;
  }

  .phone-module-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    bottom: 0.15em;
    width: 0.3rem;
    border-radius: 0.2rem;
    background: var(--module-color, var(--lumen));
  }

  .phone-row-icon svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .phone-row-name {
    flex: 1;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .phone-row-status {
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .phone-row-status.available {
    color: var(--lumen);
  }

  .phone-row-status.planned {
    color: var(--muted);
  }

  .phone-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: none;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--lumen);
    padding: 0.4rem 0;
    margin-bottom: 0.75rem;
    cursor: pointer;
    min-height: 44px;
  }

  .phone-back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .phone-module-title {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }

  .phone-module-desc,
  .phone-module-note {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .phone-tool {
    margin: 0 0 1.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--paper-dim);
  }

  .phone-tool-label {
    font-weight: 700;
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  .phone-tool textarea,
  .phone-tool input[type='number'],
  .phone-tool input[type='text'],
  .phone-tool select {
    font: inherit;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.5rem 0.6rem;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 0.6rem;
  }

  .phone-tool textarea {
    min-height: 3.5rem;
    resize: vertical;
  }

  .phone-tool-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .phone-tool-row > * {
    margin-bottom: 0 !important;
  }

  .phone-checkbox-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .phone-checkbox-row input {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .phone-tool-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }

  .phone-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .phone-chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .phone-chip:hover,
  .phone-chip:focus-visible {
    border-color: var(--lumen);
    color: var(--lumen);
  }

  .phone-chip:active {
    transform: scale(0.96);
  }

  .phone-flashcard {
    padding: 1rem;
    margin: 0 0 0.5rem;
    border-radius: 0.5rem;
    background: var(--paper);
    border: 1px solid var(--border);
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
  }

  .phone-tool-run {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.5rem 1rem;
    border-radius: 0.4rem;
    border: none;
    background: var(--lumen);
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    flex: 1;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .phone-tool-run:hover,
  .phone-tool-run:focus-visible {
    background: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-tool-run,
    .phone-chip {
      transition: none;
    }
  }

  .phone-tool-run:active {
    transform: scale(0.97);
  }

  .phone-tool-run.secondary {
    background: none;
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .phone-tool-run.secondary:hover,
  .phone-tool-run.secondary:focus-visible {
    border-color: var(--lumen);
    color: var(--lumen);
    background: none;
  }

  .phone-tool-output {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.75rem;
    border-left: 3px solid var(--lumen);
    background: var(--paper);
    font-size: 0.9rem;
    min-height: 1.3rem;
    white-space: pre-wrap;
  }

  .phone-tool-output.loading {
    color: var(--muted);
    font-style: italic;
  }

  .phone-color-swatch {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    border: 1px solid var(--border);
    border-radius: 0.25em;
    vertical-align: middle;
    margin-right: 0.4em;
  }

  .phone-home-indicator {
    width: 5rem;
    height: 0.3rem;
    border-radius: 0.2rem;
    background: var(--paper);
    opacity: 0.6;
    margin: 0.5rem auto 0.1rem;
  }

  .screenshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 3rem 2rem;
    justify-items: center;
  }

  .screenshot-card {
    margin: 0;
    width: 100%;
    max-width: 17rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .screenshot-phone {
    position: relative;
    width: 100%;
    padding: 0.5rem;
    border-radius: 2.4rem;
    background: #0a0907;
    box-shadow:
      inset 0 0 0 1px var(--border),
      0 0 0 1px color-mix(in srgb, var(--shot-color) 35%, transparent),
      0 1.5rem 4rem -1rem color-mix(in srgb, var(--shot-color) 55%, transparent);
    transition: transform 240ms ease, box-shadow 240ms ease;
  }

  .screenshot-card:hover .screenshot-phone {
    transform: translateY(-6px);
    box-shadow:
      inset 0 0 0 1px var(--border),
      0 0 0 1px color-mix(in srgb, var(--shot-color) 60%, transparent),
      0 2rem 5rem -1rem color-mix(in srgb, var(--shot-color) 75%, transparent);
  }

  .screenshot-phone img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1170 / 2532;
    object-fit: cover;
    object-position: top;
    border-radius: 1.95rem;
  }

  .screenshot-card figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin-top: 1.1rem;
    text-align: center;
    font-size: 0.9rem;
  }

  .screenshot-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
  }

  .screenshot-tagline {
    color: var(--muted, var(--ink));
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .screenshot-phone {
      transition: none;
    }

    .screenshot-card:hover .screenshot-phone {
      transform: none;
    }
  }

  .faq-list {
    max-width: var(--max);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 0;
  }

  .faq-item:first-child {
    border-top: 1px solid var(--border);
  }

  .faq-item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    cursor: pointer;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--lumen);
    transition: transform 220ms ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(135deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item summary::after {
      transition: none;
    }
  }

  .faq-item p {
    margin: 0 0 1.4rem;
    color: var(--muted);
    max-width: 60ch;
  }

  /* ---- Page building blocks shared by the marketing pages ---- */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-hero {
    padding: 4rem 0 2.5rem;
  }

  .page-hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    line-height: 1;
    margin-bottom: 1.1rem;
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lumen);
  }

  .page-hero .eyebrow {
    display: block;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  section.band {
    max-width: var(--max-wide);
    border-top: 0;
    padding: 3.5rem 0;
  }

  .section-head {
    max-width: 40rem;
    margin-bottom: 2.25rem;
  }

  .section-head.center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-head h2 {
    font-size: clamp(1.9rem, 4.5vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }

  .section-head p:not(.eyebrow) {
    color: var(--muted);
    font-size: 1.15rem;
    margin: 0;
  }

  .fact-row {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fact-row li {
    padding: 0.3rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper-dim) 80%, transparent);
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .card-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .card-grid.cols-2 {
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }

  .card-grid.cols-4 {
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
  }

  .info-card {
    position: relative;
    padding: 1.6rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--paper-dim);
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .info-card:hover {
    border-color: color-mix(in srgb, var(--lumen) 55%, var(--border));
    transform: translateY(-3px);
  }

  .info-card h3 {
    margin: 0.9rem 0 0.45rem;
  }

  .info-card p {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .info-card .card-icon {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--lumen) 14%, var(--paper-dim));
    color: var(--lumen);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--lumen) 28%, transparent);
  }

  .card-icon svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .module-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, 1fr);
  }

  .module-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.25rem 1.25rem;
    border-radius: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--module-color) 32%, var(--border));
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--module-color) 16%, var(--paper-dim)) 0%,
      var(--paper-dim) 70%
    );
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .module-card:hover,
  .module-card:focus-within {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--module-color) 70%, var(--border));
    box-shadow: 0 1.25rem 2.5rem -1.25rem color-mix(in srgb, var(--module-color) 70%, transparent);
  }

  .module-card .module-icon {
    width: 3rem;
    height: 3rem;
    background: var(--paper);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--module-color) 45%, transparent),
      0 0 1.6rem color-mix(in srgb, var(--module-color) 35%, transparent);
  }

  .module-card .module-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .module-card h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.2rem;
  }

  .module-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .module-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .module-card h3 a:focus-visible {
    outline: none;
  }

  .module-card:focus-within {
    outline: 3px solid var(--lumen);
    outline-offset: 2px;
  }

  .module-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .steps {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    counter-reset: step;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    counter-increment: step;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--paper-dim);
  }

  .steps li::before {
    content: counter(step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 0.9rem;
    border-radius: 50%;
    background: var(--lumen);
    color: var(--paper);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .steps h3 {
    margin: 0 0 0.4rem;
  }

  .steps p {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .showcase {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    align-items: start;
  }

  .showcase .screenshot-card:nth-child(even) {
    margin-top: 2.5rem;
  }

  .status-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .status-card {
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--paper-dim);
  }

  .status-card h3 {
    margin: 0 0 1rem;
  }

  .status-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  .status-card li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink);
    font-size: 1.02rem;
  }

  .status-card li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.55em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--lumen);
  }

  .status-card.pending li {
    color: var(--muted);
  }

  .status-card.pending li::before {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--muted);
  }

  .cta-panel {
    position: relative;
    overflow: hidden;
    padding: 3.5rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--lumen) 35%, var(--border));
    border-radius: 2rem;
    text-align: center;
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in srgb, var(--glow) 24%, var(--paper-dim)) 0%,
      var(--paper-dim) 65%
    );
  }

  .cta-panel h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }

  .cta-panel p {
    color: var(--muted);
    max-width: 34rem;
    margin: 0 auto 1.75rem;
  }

  .cta-panel .cta-row {
    justify-content: center;
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .link-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--paper-dim);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .link-list a::after {
    content: '\2192';
    color: var(--lumen);
  }

  .link-list a:hover,
  .link-list a:focus-visible {
    border-color: var(--lumen);
    transform: translateX(3px);
    color: var(--ink);
  }

  pre.code-block {
    margin: 0 0 1.25rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--paper-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  code {
    font-size: 0.92em;
    padding: 0.08em 0.35em;
    border-radius: 0.3rem;
    background: var(--paper-dim);
  }

  pre.code-block code {
    padding: 0;
    background: none;
  }

  .not-found {
    text-align: center;
    padding: 6rem 0 5rem;
  }

  .not-found .code-num {
    font-size: clamp(5rem, 20vw, 9rem);
