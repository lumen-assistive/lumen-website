---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/modules/', label: 'Modules' },
  { href: '/demo/', label: 'Demo' },
  { href: '/screenshots/', label: 'Screenshots' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/sdk/', label: 'SDK' },
  { href: '/download/', label: 'Download' },
  { href: '/docs/', label: 'Docs' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Lumen</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="bar">
        <a class="brand" href="/">
          <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
            <path d="M 33.2 10.9 A 16 16 0 1 1 14.8 10.9" />
          </svg>
          Lumen
        </a>
        <nav aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href="/">
              <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
                <path d="M 33.2 10.9 A 16 16 0 1 1 14.8 10.9" />
              </svg>
              Lumen
            </a>
            <p>An open source, offline-first, privacy-by-design assistant for people with a limitation. Built for the GF Marilli Prize by HackersGen.</p>
          </div>

          <nav class="footer-col" aria-label="Product">
            <h2>Product</h2>
            <a href="/">Home</a>
            <a href="/modules/">Modules</a>
            <a href="/demo/">Demo</a>
            <a href="/screenshots/">Screenshots</a>
            <a href="/download/">Download</a>
          </nav>

          <nav class="footer-col" aria-label="Developers">
            <h2>Developers</h2>
            <a href="/sdk/">SDK</a>
            <a href="/docs/">Docs</a>
            <a href="https://github.com/lumen-assistive/lumen-plugins">Plugins</a>
            <a href="https://github.com/lumen-assistive">GitHub</a>
          </nav>

          <nav class="footer-col" aria-label="Project">
            <h2>Project</h2>
            <a href="/privacy/">Privacy</a>
            <a href="https://github.com/lumen-assistive/lumen-website/blob/main/CONTRIBUTING.md">Contributing</a>
            <a href="https://github.com/lumen-assistive/lumen-website/blob/main/CODE_OF_CONDUCT.md">Code of conduct</a>
            <a href="https://github.com/lumen-assistive/lumen-website/blob/main/SECURITY.md">Security</a>
          </nav>
        </div>

        <div class="footer-bottom">
          <p>Licensed under the Apache License 2.0.</p>
          <p><a href="https://github.com/lumen-assistive">github.com/lumen-assistive</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --paper: #fdfbf5;
    --paper-dim: #f1ece0;
    --ink: #1c1a16;
    --muted: #6b655a;
    --lumen: #8f5c13;
    --border: #e3ddcc;
    --max: 46rem;
    --max-wide: 58rem;
    --font: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #19170f;
      --paper-dim: #231f16;
      --ink: #f3efe2;
      --muted: #b7ae99;
      --lumen: #e3a94a;
      --border: #3a3424;
    }
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--lumen);
    color: var(--paper);
    padding: 0.75rem 1rem;
    z-index: 10;
    font-weight: 700;
  }

  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  header {
    border-bottom: 1px solid var(--border);
  }

  .bar {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    fill: none;
    stroke: var(--lumen);
    stroke-width: 6;
    stroke-linecap: round;
  }

  nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-left: auto;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.5rem 0.1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--ink);
  }

  a {
    color: var(--ink);
    text-decoration-color: var(--lumen);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }

  a:hover,
  a:focus-visible {
    color: var(--lumen);
  }

  :focus-visible {
    outline: 3px solid var(--lumen);
    outline-offset: 2px;
  }

  main {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    max-width: var(--max);
    padding: 4rem 0 3rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .lead {
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--ink);
    max-width: 38ch;
    margin: 0 0 2rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.7rem 1.4rem;
    border-radius: 0.3rem;
    font-weight: 700;
    text-decoration: none;
  }

  .button.primary {
    background: var(--lumen);
    color: var(--paper);
  }

  .button.primary:hover,
  .button.primary:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .button.secondary {
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    border-color: var(--lumen);
    color: var(--lumen);
  }

  section {
    max-width: var(--max);
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }

  section.wide {
    max-width: var(--max-wide);
  }

  h2 {
    font-size: 1.9rem;
    margin: 0 0 1.25rem;
  }

  h3 {
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }

  p {
    margin: 0 0 1.2rem;
  }

  .notice {
    border-left: 3px solid var(--lumen);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--paper-dim);
  }

  .module-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .module-list li {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .module-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .module-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .module-head h3 {
    margin: 0;
  }

  .status {
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .status.available {
    color: var(--lumen);
  }

  .status.planned {
    color: var(--muted);
  }

  .demo-block {
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--paper-dim);
  }

  .demo-block label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .demo-block textarea,
  .demo-block input[type='number'] {
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.6rem 0.75rem;
    width: 100%;
    box-sizing: border-box;
  }

  .demo-block textarea {
    min-height: 5rem;
    resize: vertical;
    margin-bottom: 0.75rem;
  }

  .demo-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .demo-row label {
    margin-bottom: 0.2rem;
  }

  .demo-row input[type='number'] {
    width: 6rem;
  }

  .demo-output {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--lumen);
    background: var(--paper);
    min-height: 1.5rem;
    white-space: pre-wrap;
  }

  .color-swatch {
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    border: 1px solid var(--border);
    border-radius: 0.2em;
    vertical-align: middle;
    margin-right: 0.5em;
  }

  footer {
    border-top: 1px solid var(--border);
    margin-top: 2rem;
    background: var(--paper-dim);
  }

  .footer-inner {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .footer-brand p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.85rem 0 0;
    max-width: 30ch;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col h2 {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0 0 0.2rem;
  }

  .footer-col a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--lumen);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom a {
    color: var(--muted);
    text-decoration-color: var(--lumen);
  }

  .footer-bottom a:hover,
  .footer-bottom a:focus-visible {
    color: var(--lumen);
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  .phone-demo {
    display: flex;
    justify-content: center;
    padding: 1rem 0 3rem;
  }

  .phone {
    position: relative;
    width: min(360px, 100%);
    background: var(--ink);
    border-radius: 2.5rem;
    padding: 0.65rem;
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.3), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .phone-side-button {
    position: absolute;
    background: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .phone-side-power {
    right: -0.15rem;
    top: 7.5rem;
    width: 0.15rem;
    height: 3.5rem;
    border-radius: 0 0.15rem 0.15rem 0;
  }

  .phone-side-volume-up {
    left: -0.15rem;
    top: 6rem;
    width: 0.15rem;
    height: 2.25rem;
    border-radius: 0.15rem 0 0 0.15rem;
  }

  .phone-side-volume-down {
    left: -0.15rem;
    top: 9rem;
    width: 0.15rem;
    height: 2.25rem;
    border-radius: 0.15rem 0 0 0.15rem;
  }

  .phone-notch {
    position: absolute;
    top: 0.65rem;
    left: 50%;
    transform: translateX(-50%);
    width: 6.5rem;
    height: 1.4rem;
    background: var(--ink);
    border-radius: 0 0 1rem 1rem;
    z-index: 2;
  }

  .phone-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.5rem 0.2rem;
    color: var(--paper);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .phone-statusbar-icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .phone-screen {
    position: relative;
    background: var(--paper);
    border-radius: 1.85rem;
    overflow: hidden;
    height: 600px;
    display: flex;
    flex-direction: column;
  }

  .phone-app-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem 0.9rem;
    font-weight: 700;
    font-size: 1.1rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .phone-app-header .phone-mark {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--lumen);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .phone-view {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem 1.5rem;
  }

  .phone-view:not([hidden]) {
    animation: phone-view-in 260ms ease;
  }

  @keyframes phone-view-in {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-view:not([hidden]) {
      animation: none;
    }
  }

  .phone-view-title {
    font-weight: 700;
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
  }

  .phone-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.65rem 0.4rem;
    border: none;
    border-bottom: 1px solid var(--border);
    background: none;
    text-align: left;
    font: inherit;
    color: var(--ink);
    cursor: pointer;
    min-height: 48px;
  }

  .phone-row:first-of-type {
    border-top: 1px solid var(--border);
  }

  .phone-row:hover,
  .phone-row:focus-visible {
    background: var(--paper-dim);
  }

  .phone-row:active {
    transform: scale(0.99);
  }

  .phone-row-icon {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    background: var(--paper-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lumen);
  }

  .phone-row-icon svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .phone-row-name {
    flex: 1;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .phone-row-status {
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .phone-row-status.available {
    color: var(--lumen);
  }

  .phone-row-status.planned {
    color: var(--muted);
  }

  .phone-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: none;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--lumen);
    padding: 0.4rem 0;
    margin-bottom: 0.75rem;
    cursor: pointer;
    min-height: 44px;
  }

  .phone-back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .phone-module-title {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }

  .phone-module-desc,
  .phone-module-note {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .phone-tool {
    margin: 0 0 1.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--paper-dim);
  }

  .phone-tool-label {
    font-weight: 700;
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  .phone-tool textarea,
  .phone-tool input[type='number'],
  .phone-tool input[type='text'],
  .phone-tool select {
    font: inherit;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.5rem 0.6rem;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 0.6rem;
  }

  .phone-tool textarea {
    min-height: 3.5rem;
    resize: vertical;
  }

  .phone-tool-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .phone-tool-row > * {
    margin-bottom: 0 !important;
  }

  .phone-checkbox-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .phone-checkbox-row input {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .phone-tool-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }

  .phone-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .phone-chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }

  .phone-chip:hover,
  .phone-chip:focus-visible {
    border-color: var(--lumen);
    color: var(--lumen);
  }

  .phone-chip:active {
    transform: scale(0.96);
  }

  .phone-flashcard {
    padding: 1rem;
    margin: 0 0 0.5rem;
    border-radius: 0.5rem;
    background: var(--paper);
    border: 1px solid var(--border);
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
  }

  .phone-tool-run {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.5rem 1rem;
    border-radius: 0.4rem;
    border: none;
    background: var(--lumen);
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    flex: 1;
  }

  .phone-tool-run:hover,
  .phone-tool-run:focus-visible {
    background: var(--ink);
  }

  .phone-tool-run:active {
    transform: scale(0.97);
  }

  .phone-tool-run.secondary {
    background: none;
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .phone-tool-run.secondary:hover,
  .phone-tool-run.secondary:focus-visible {
    border-color: var(--lumen);
    color: var(--lumen);
    background: none;
  }

  .phone-tool-output {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.75rem;
    border-left: 3px solid var(--lumen);
    background: var(--paper);
    font-size: 0.9rem;
    min-height: 1.3rem;
    white-space: pre-wrap;
  }

  .phone-tool-output.loading {
    color: var(--muted);
    font-style: italic;
  }

  .phone-color-swatch {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    border: 1px solid var(--border);
    border-radius: 0.25em;
    vertical-align: middle;
    margin-right: 0.4em;
  }

  .phone-home-indicator {
    width: 5rem;
    height: 0.3rem;
    border-radius: 0.2rem;
    background: var(--paper);
    opacity: 0.6;
    margin: 0.5rem auto 0.1rem;
  }

  .screenshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
  }

  .screenshot-card {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--paper-dim);
  }

  .screenshot-card img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
  }

  .screenshot-card figcaption {
    display: flex;
