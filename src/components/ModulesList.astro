---
import { getModules } from '../lib/modules';
import { MODULE_ICONS, MODULE_COLORS } from '../lib/moduleVisuals';

const modules = await getModules();
---

<div class="module-detail-grid">
  {modules.map((mod) => (
    <article class="module-card module-detail" style={`--module-color: ${MODULE_COLORS[mod.id] ?? 'var(--lumen)'}`}>
      <div class="module-head">
        <span
          class="module-icon"
          aria-hidden="true"
          set:html={`<svg viewBox="0 0 24 24">${MODULE_ICONS[mod.id] ?? ''}</svg>`}
        />
        {mod.repoUrl ? (
          <span class="status available">Package available</span>
        ) : (
          <span class="status planned">Planned</span>
        )}
      </div>
      <h3>{mod.nameEn}</h3>
      {mod.description && <p>{mod.description}</p>}
      <p class="module-links">
        <a href={`/docs/app/modules/${mod.id}/`}>App screen</a>
        <a href={`/docs/plugins/${mod.id}/`}>Package reference</a>
        {mod.repoUrl && <a href={mod.repoUrl}>Source</a>}
      </p>
    </article>
  ))}
</div>
