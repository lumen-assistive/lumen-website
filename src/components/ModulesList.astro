---
import { getModules } from '../lib/modules';
import { MODULE_ICONS, MODULE_COLORS } from '../lib/moduleVisuals';

const modules = await getModules();
---

<ul class="module-list">
  {modules.map((mod) => (
    <li>
      <div class="module-head">
        <h3>
          <span
            class="module-icon"
            style={`--module-color: ${MODULE_COLORS[mod.id] ?? 'var(--lumen)'}`}
            set:html={`<svg viewBox="0 0 24 24" aria-hidden="true">${MODULE_ICONS[mod.id] ?? ''}</svg>`}
          />
          {mod.nameEn}
        </h3>
        {mod.repoUrl ? (
          <span class="status available">Repository available</span>
        ) : (
          <span class="status planned">Planned</span>
        )}
      </div>
      {mod.description && <p>{mod.description}</p>}
      {mod.repoUrl && (
        <p><a href={mod.repoUrl}>lumen-plugins/packages/{mod.id}</a></p>
      )}
    </li>
  ))}
</ul>
