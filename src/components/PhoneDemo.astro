---
// The interactive demo: a phone running a faithful HTML/CSS port of the real
// Flutter app (lumen-app), wired to the real plugin logic compiled to
// JavaScript (public/demo/lumen-demo.js, built from tools/web-demo).
//
// Everything the phone shows comes from three real sources, embedded below as
// data for public/demo/phone.js to render:
//  - appStrings.json: the app's exact English UI strings, extracted from
//    lumen-app/lib/src/l10n/app_strings.dart by tools/web-demo/extract_strings.py;
//  - the palette from lumen-app/lib/src/theme/app_colors.dart;
//  - the per-module icons, identical to the app's `ModuleIcon` geometry.
import strings from '../lib/appStrings.json';
import { MODULE_ICONS } from '../lib/moduleVisuals';

// lumen-app/lib/src/theme/app_colors.dart: AppColors.moduleColors, one solid fill per module.
const colors = {
  vision: '#5CC8E0',
  hearing: '#B9A2FF',
  safety: '#FF8FA3',
  family: '#FF9FCB',
  speech: '#FFA860',
  reading: '#7ADB98',
  memory: '#9FA9FF',
  mobility: '#F2C94E',
};

// lumen-app/lib/src/onboarding/module_catalog.dart: fixed display order.
const modules = [
  ['vision', 'moduleNameVision', 'moduleDescriptionVision'],
  ['hearing', 'moduleNameHearing', 'moduleDescriptionHearing'],
  ['safety', 'moduleNameSafety', 'moduleDescriptionSafety'],
  ['family', 'moduleNameFamily', 'moduleDescriptionFamily'],
  ['speech', 'moduleNameSpeech', 'moduleDescriptionSpeech'],
  ['reading', 'moduleNameReading', 'moduleDescriptionReading'],
  ['memory', 'moduleNameMemory', 'moduleDescriptionMemory'],
  ['mobility', 'moduleNameMobility', 'moduleDescriptionMobility'],
].map(([id, nameKey, descriptionKey]) => ({ id, nameKey, descriptionKey }));

const data = { strings, colors, modules, icons: MODULE_ICONS };
---

<div class="lp-demo" id="lumen-demo-root">
  <div class="lp-stage" id="lumen-demo-stage">
    <div class="lp-device" id="lumen-demo-device">
      <span class="lp-side lp-side-power" aria-hidden="true"></span>
      <span class="lp-side lp-side-up" aria-hidden="true"></span>
      <span class="lp-side lp-side-down" aria-hidden="true"></span>
      <div class="lp-screen" id="lumen-demo" role="group" aria-label="Interactive Lumen app demo">
        <noscript>
          <p class="lp-noscript">
            The demo runs the real plugin logic in your browser and needs JavaScript. Without it,
            see the <a href="/screenshots/">screenshots</a> of the same screens.
          </p>
        </noscript>
      </div>
    </div>
  </div>
  <p class="lp-controls">
    <button type="button" class="lp-restart" id="lumen-demo-restart">Restart the demo</button>
    <span class="lp-hint">Scroll inside the phone. Escape goes back.</span>
  </p>
  <script type="application/json" id="lumen-demo-data" set:html={JSON.stringify(data)} />
</div>

<style is:global>
  /* ---- Stage and device ------------------------------------------------ */
  .lp-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0 2rem;
  }

  .lp-stage {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: clip;
    overflow-clip-margin: 80px;
    /* Height is set by phone.js from the scaled device height. */
  }

  .lp-device {
    position: relative;
    flex: none;
    width: 414px;
    padding: 12px;
    border-radius: 58px;
    background: #090806;
    box-shadow:
      inset 0 0 0 1px #3a3424,
      0 0 0 1px #1c1810,
      0 32px 80px -24px rgba(0, 0, 0, 0.75);
    transform-origin: top center;
  }

  .lp-side {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: #1c1810;
  }

  .lp-side-power {
    right: -4px;
    top: 150px;
    height: 80px;
  }

  .lp-side-up {
    left: -4px;
    top: 130px;
    height: 56px;
  }

  .lp-side-down {
    left: -4px;
    top: 200px;
    height: 56px;
  }

  .lp-device.lp-compact {
    width: 390px;
    padding: 0;
    border-radius: 30px;
  }

  .lp-device.lp-compact .lp-side {
    display: none;
  }

  /* ---- Screen: tokens mirror lumen-app/lib/src/theme/app_colors.dart --- */
  .lp-screen {
    --bg: #f3eee3;
    --surface: #fffcf5;
    --ink: #1a1815;
    --muted: #5b554a;
    --hairline: #d3cbb8;
    --amber: #f2b138;
    --critical: #c1272d;
    --accent: var(--amber);
    --ts: 1;

    --fs-display-m: calc(45px * var(--ts));
    --fs-display-s: calc(36px * var(--ts));
    --fs-headline-m: calc(28px * var(--ts));
    --fs-title-l: calc(22px * var(--ts));
    --fs-title-m: calc(16px * var(--ts));
    --fs-body-l: calc(16px * var(--ts));
    --fs-body-m: calc(14px * var(--ts));
    --fs-body-s: calc(12px * var(--ts));

    position: relative;
    width: 390px;
    height: 800px;
    overflow: hidden;
    border-radius: 46px;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: var(--fs-body-m);
    line-height: 1.43;
    letter-spacing: 0.25px;
    -webkit-font-smoothing: antialiased;
    isolation: isolate;
  }

  .lp-compact .lp-screen {
    border-radius: 30px;
  }

  .lp-screen *,
  .lp-screen *::before,
  .lp-screen *::after {
    box-sizing: border-box;
  }

  /* Resets use :where() so they never outrank the component classes below. */
  :where(.lp-screen) :is(button, input, select, textarea) {
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }

  :where(.lp-screen) :is(p, h1, h2, h3) {
    margin: 0;
    max-width: none;
  }

  .lp-screen :focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .lp-noscript {
    padding: 80px 24px;
    text-align: center;
  }

  /* ---- System status bar (device chrome, not part of the app) --------- */
  .lp-status {
    position: absolute;
    z-index: 30;
    top: 0;
    left: 0;
    right: 0;
    height: 40px;
    padding: 12px 28px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    pointer-events: none;
    color: var(--ink);
  }

  .lp-status-icons {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  .lp-notch {
    position: absolute;
    z-index: 31;
    top: 10px;
    left: 50%;
    width: 96px;
    height: 26px;
    transform: translateX(-50%);
    border-radius: 14px;
    background: #000;
    pointer-events: none;
  }

  /* ---- Pages ----------------------------------------------------------- */
  .lp-page {
    position: absolute;
    inset: 0;
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }

  .lp-page[hidden] {
    display: none;
  }

  .lp-appbar {
    position: relative;
    z-index: 2;
    flex: none;
    height: 56px;
    display: flex;
    align-items: center;
    padding: 0 16px;
  }

  .lp-appbar-title {
    margin-left: 16px;
    font-size: calc(24px * var(--ts));
    font-weight: 700;
    line-height: 1.2;
  }

  .lp-scroll {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .lp-scroll::-webkit-scrollbar {
    display: none;
  }

  .lp-list {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* IconButton: a paper square with a 2px ink outline, radius 14. */
  .lp-iconbtn {
    flex: none;
    width: 48px;
    height: 48px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border-radius: 14px;
    border: 2px solid var(--ink);
    background: var(--surface);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .lp-iconbtn:hover {
    background: var(--hairline);
  }

  .lp-iconbtn svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  /* ---- Entrance motion: FadeSlideIn in the app ------------------------- */
  @keyframes lp-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .lp-page.lp-enter .lp-card,
  .lp-page.lp-enter .lp-home-card,
  .lp-page.lp-enter .lp-phrase {
    animation: lp-in 420ms cubic-bezier(0.215, 0.61, 0.355, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-page.lp-enter .lp-card,
    .lp-page.lp-enter .lp-home-card,
    .lp-page.lp-enter .lp-phrase {
      animation: none;
    }
  }

  /* ---- Module badge: ModuleBadge --------------------------------------- */
  .lp-badge {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--d);
    height: var(--d);
    border-radius: calc(var(--d) * 0.3);
    background: var(--c);
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .lp-badge svg {
    width: calc(var(--d) * 0.5);
    height: calc(var(--d) * 0.5);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lp-mark {
    flex: none;
    fill: none;
    stroke-linecap: round;
  }

  /* ---- Home ------------------------------------------------------------ */
  .lp-home-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px 0;
  }

  .lp-home-top .lp-iconbtn {
    margin-left: auto;
  }

  .lp-wordmark {
    font-size: var(--fs-title-l);
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.27;
  }

  .lp-home-body {
    padding: 32px 20px 32px;
  }

  .lp-headline {
    font-size: var(--fs-display-m);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -1.5px;
  }

  .lp-subtitle {
    margin-top: 14px;
    font-size: var(--fs-body-l);
    line-height: 1.5;
    letter-spacing: 0.5px;
    color: var(--muted);
  }

  .lp-section-label {
    margin-top: 32px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-body-m);
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lp-section-label::after {
    content: '';
    order: 1;
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .lp-count {
    order: 2;
    color: var(--ink);
    letter-spacing: 0.1px;
  }

  .lp-home-list {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: stretch;
  }

  .lp-home-list.lp-single {
    grid-template-columns: 1fr;
  }

  .lp-home-card {
    appearance: none;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 18px;
    text-align: left;
    cursor: pointer;
    border-radius: 24px;
    border: 2px solid var(--ink);
    background: var(--c);
    color: var(--ink);
    transition: transform 160ms ease;
  }

  .lp-home-card:hover {
    transform: translateY(-2px);
  }

  .lp-home-card:active {
    transform: scale(0.985);
  }

  .lp-home-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .lp-home-card-top svg {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    width: 36px;
    height: 36px;
  }

  .lp-home-card-top svg.lp-arrow {
    width: 24px;
    height: 24px;
    fill: var(--ink);
    stroke: none;
  }

  .lp-home-card-name {
    display: block;
    font-size: var(--fs-title-l);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.4px;
  }

  .lp-home-card-desc {
    display: block;
    margin-top: 6px;
    font-size: var(--fs-body-s);
    line-height: 1.35;
    letter-spacing: 0.4px;
  }

  .lp-empty {
    grid-column: 1 / -1;
    padding: 32px 0;
    text-align: center;
    font-size: var(--fs-title-m);
    line-height: 1.5;
  }

  /* ---- Module screens: ModuleScope + ModuleHeader + ModuleNote ---------- */
  .lp-module {
    --accent: var(--c);
  }

  .lp-header {
    display: block;
    padding: 22px;
    border-radius: 28px;
    border: 2px solid var(--ink);
    background: var(--c);
  }

  .lp-header svg {
    display: block;
    width: 44px;
    height: 44px;
    margin-bottom: 28px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lp-header-name {
    font-size: var(--fs-display-s);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -1px;
  }

  .lp-header-desc {
    margin-top: 8px;
    font-size: var(--fs-body-l);
    line-height: 1.5;
    letter-spacing: 0.5px;
  }

  .lp-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 1.5px solid var(--hairline);
    border-radius: 14px;
  }

  .lp-note svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: var(--muted);
  }

  .lp-note p {
    font-size: var(--fs-body-m);
    line-height: 1.45;
    letter-spacing: 0.25px;
    color: var(--muted);
  }

  /* ---- ToolCard --------------------------------------------------------- */
  .lp-card {
    padding: 20px;
    border-radius: 20px;
    background: var(--surface);
    border: 2px solid var(--ink);
  }

  .lp-card-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .lp-card-title::before {
    content: '';
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 2px solid var(--ink);
    background: var(--accent);
  }

  .lp-card-title h3 {
    font-size: var(--fs-title-m);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.2px;
  }

  .lp-gap-12 {
    margin-top: 12px;
  }

  .lp-gap-8 {
    margin-top: 8px;
  }

  .lp-text {
    font-size: var(--fs-body-m);
    line-height: 1.43;
    letter-spacing: 0.25px;
  }

  .lp-text-row {
    margin-top: 8px;
  }

  /* ---- Text fields: paper fill, 1.5px ink outline, floating label ------- */
  .lp-field {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .lp-field input,
  .lp-field textarea {
    display: block;
    width: 100%;
    padding: 16px;
    border-radius: 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    font-size: var(--fs-body-l);
    line-height: 1.5;
    letter-spacing: 0.5px;
    resize: none;
    overflow: hidden;
  }

  .lp-field input {
    height: 56px;
  }

  .lp-field input:focus,
  .lp-field textarea:focus {
    outline: none;
    border: 3px solid var(--ink);
    padding: 14.5px;
  }

  .lp-field label {
    position: absolute;
    left: 12px;
    top: -9px;
    padding: 0 4px;
    font-size: var(--fs-body-s);
    line-height: 1.33;
    letter-spacing: 0.4px;
    color: var(--muted);
    background: var(--surface);
    pointer-events: none;
    transition: all 120ms ease;
    max-width: calc(100% - 24px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lp-field input:placeholder-shown:not(:focus) + label,
  .lp-field textarea:placeholder-shown:not(:focus) + label {
    top: 16px;
    left: 16px;
    padding: 0;
    font-size: var(--fs-body-l);
    line-height: 1.5;
    letter-spacing: 0.5px;
    background: transparent;
  }

  .lp-field input:focus + label,
  .lp-field textarea:focus + label {
    color: var(--ink);
  }

  .lp-fields-row {
    display: flex;
    gap: 8px;
  }

  /* ---- Buttons: ink-filled primary, outlined secondary, radius 14 -------- */
  .lp-btn {
    appearance: none;
    width: 100%;
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border-radius: 14px;
    border: 2px solid var(--ink);
    font-size: calc(16px * var(--ts));
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.15px;
    cursor: pointer;
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .lp-btn span {
    text-align: center;
  }

  .lp-btn-primary {
    background: var(--ink);
    color: var(--bg);
  }

  .lp-btn-tonal,
  .lp-btn-plain {
    padding: 0 16px;
    color: var(--ink);
    background: var(--surface);
  }

  .lp-btn:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .lp-btn-tonal:hover:not(:disabled),
  .lp-btn-plain:hover:not(:disabled) {
    background: var(--bg);
  }

  .lp-btn:active:not(:disabled) {
    transform: scale(0.985);
  }

  .lp-btn:disabled {
    cursor: default;
  }

  .lp-btn-primary:disabled {
    border-color: transparent;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    color: color-mix(in srgb, var(--ink) 38%, transparent);
  }

  .lp-btn-tonal:disabled,
  .lp-btn-plain:disabled {
    background: transparent;
    border-color: color-mix(in srgb, var(--ink) 12%, transparent);
    color: color-mix(in srgb, var(--ink) 38%, transparent);
  }

  .lp-row {
    display: flex;
    gap: 8px;
  }

  .lp-row > * {
    flex: 1;
    min-width: 0;
  }

  .lp-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ---- ToolOutput: a solid block in the module color --------------------- */
  .lp-out {
    margin-top: 14px;
    border-radius: 14px;
    border: 2px solid var(--ink);
    background: var(--accent);
  }

  .lp-out[hidden] {
    display: none;
  }

  .lp-out p {
    padding: 16px;
    font-size: var(--fs-body-l);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.5px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .lp-swatch {
    margin-top: 8px;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border: 2px solid var(--ink);
  }

  .lp-swatch[hidden] {
    display: none;
  }

  /* ---- Dropdown: StyledDropdown ----------------------------------------- */
  .lp-select {
    position: relative;
  }

  .lp-select select {
    appearance: none;
    width: 100%;
    height: 52px;
    padding: 0 44px 0 16px;
    border-radius: 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    font-size: var(--fs-body-l);
    letter-spacing: 0.5px;
    cursor: pointer;
  }

  .lp-select svg {
    position: absolute;
    right: 12px;
    top: 14px;
    width: 24px;
    height: 24px;
    fill: var(--ink);
    pointer-events: none;
  }

  /* ---- Checkbox tiles ---------------------------------------------------- */
  .lp-check {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    cursor: pointer;
    font-size: var(--fs-body-l);
    line-height: 1.5;
    letter-spacing: 0.5px;
  }

  .lp-check input {
    appearance: none;
    flex: none;
    width: 18px;
    height: 18px;
    margin: 0 15px 0 0;
    border-radius: 2px;
    border: 2px solid var(--ink);
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .lp-check input:checked {
    background: var(--ink);
  }

  .lp-check input:checked::after {
    content: '';
    width: 5px;
    height: 10px;
    margin-top: -2px;
    border: solid var(--bg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* ---- Chips: radius 12, 1.5px ink outline ------------------------------- */
  .lp-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lp-chip {
    appearance: none;
    min-height: 40px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    border-radius: 12px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    font-size: var(--fs-body-m);
    font-weight: 700;
    letter-spacing: 0.1px;
    color: var(--ink);
  }

  button.lp-chip {
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  button.lp-chip:hover {
    background: var(--bg);
  }

  button.lp-chip:active {
    transform: scale(0.96);
  }

  .lp-phrase {
    padding: 36px 24px;
    border-radius: 28px;
    border: 2px solid var(--ink);
    text-align: center;
    font-size: var(--fs-headline-m);
    font-weight: 700;
    line-height: 1.29;
    letter-spacing: 0;
    color: var(--ink);
    background: var(--accent);
  }

  .lp-phrase[hidden] {
    display: none;
  }

  /* The app's flashcard is a Card in the scheme's primary container: ink. */
