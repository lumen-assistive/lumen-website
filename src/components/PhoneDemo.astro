---
// A simulated Lumen home screen inside a phone frame. The module list and
// descriptions are the same real data as the Modules page (see
// src/lib/modules.ts). Every one of the eight modules below runs real
// compiled plugin logic from /demo/lumen-demo.js (wired up by the parent
// page): nothing here is a reimplementation or a static mockup screenshot.
import { getModules } from '../lib/modules';
import { MODULE_ICONS, MODULE_COLORS } from '../lib/moduleVisuals';

const modules = await getModules();
---

<div class="phone-demo">
  <div class="phone">
    <div class="phone-side-button phone-side-power" aria-hidden="true"></div>
    <div class="phone-side-button phone-side-volume-up" aria-hidden="true"></div>
    <div class="phone-side-button phone-side-volume-down" aria-hidden="true"></div>

    <div class="phone-notch" aria-hidden="true"></div>
    <div class="phone-statusbar" aria-hidden="true">
      <span>9:41</span>
      <span class="phone-statusbar-icons">
        <svg viewBox="0 0 24 24" width="15" height="11">
          <path d="M2 9 Q12 0 22 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <circle cx="12" cy="9.5" r="1.3" fill="currentColor" />
        </svg>
        <svg viewBox="0 0 24 24" width="20" height="11">
          <rect x="1" y="1.5" width="18" height="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" />
          <rect x="20" y="4" width="1.6" height="3" fill="currentColor" />
          <rect x="2.3" y="2.8" width="13" height="5.4" fill="currentColor" />
        </svg>
      </span>
    </div>

    <div class="phone-screen" role="group" aria-label="Simulated Lumen app">
      <header class="phone-app-header">
        <svg class="phone-mark" viewBox="0 0 48 48" aria-hidden="true">
          <path d="M 33.2 10.9 A 16 16 0 1 1 14.8 10.9" />
        </svg>
        <span>Lumen</span>
      </header>

      <div class="phone-view" data-view="home">
        <p class="phone-view-title" tabindex="-1">Your modules</p>
        {modules.map((mod) => (
          <button class="phone-row" type="button" data-open={mod.id} aria-label={`Open ${mod.nameEn}`}>
            <span
              class="phone-row-icon"
              style={`--module-color: ${MODULE_COLORS[mod.id] ?? 'var(--lumen)'}`}
              set:html={`<svg viewBox="0 0 24 24">${MODULE_ICONS[mod.id]}</svg>`}
            />
            <span class="phone-row-name">{mod.nameEn}</span>
            <span class={`phone-row-status ${mod.repoUrl ? 'available' : 'planned'}`}>
              {mod.repoUrl ? 'Available' : 'Planned'}
            </span>
          </button>
        ))}
      </div>

      {modules.map((mod) => (
        <div class="phone-view" data-view={mod.id} hidden>
          <button class="phone-back" type="button" data-back>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            Modules
          </button>
          <h3 class="phone-module-title" style={`--module-color: ${MODULE_COLORS[mod.id] ?? 'var(--lumen)'}`}>
            {mod.nameEn}
          </h3>
          {mod.description && <p class="phone-module-desc">{mod.description}</p>}

          {mod.id === 'vision' && (
            <Fragment>
              <div class="phone-tool">
                <p class="phone-tool-label">Expiry date reader</p>
                <textarea id="expiry-input" rows="2">Da consumarsi preferibilmente entro il 25/12/2026</textarea>
                <button class="phone-tool-run" type="button" id="expiry-run">Find date</button>
                <p class="phone-tool-output" id="expiry-output" aria-live="polite"></p>
              </div>
              <div class="phone-tool">
                <p class="phone-tool-label">Color namer</p>
                <div class="phone-tool-row">
                  <input id="color-r" type="number" min="0" max="255" value="225" aria-label="Red, 0 to 255" />
                  <input id="color-g" type="number" min="0" max="255" value="25" aria-label="Green, 0 to 255" />
                  <input id="color-b" type="number" min="0" max="255" value="15" aria-label="Blue, 0 to 255" />
                </div>
                <button class="phone-tool-run" type="button" id="color-run">Name color</button>
                <p class="phone-tool-output" id="color-output" aria-live="polite"></p>
              </div>
              <div class="phone-tool">
                <p class="phone-tool-label">Contrast checker</p>
                <p class="phone-tool-note">Checks the color above against a white and a black background.</p>
                <button class="phone-tool-run" type="button" id="contrast-run">Check contrast</button>
                <p class="phone-tool-output" id="contrast-output" aria-live="polite"></p>
              </div>
            </Fragment>
          )}

          {mod.id === 'hearing' && (
            <div class="phone-tool">
              <p class="phone-tool-label">Transcript summarizer</p>
              <textarea id="summary-input" rows="3">Il gatto dorme sul divano. Il cane corre in giardino con il gatto. Oggi piove molto a Milano. Il gatto e il cane giocano insieme in giardino.</textarea>
              <button class="phone-tool-run" type="button" id="summary-run">Summarize</button>
              <p class="phone-tool-output" id="summary-output" aria-live="polite"></p>
            </div>
          )}

          {mod.id === 'safety' && (
            <div class="phone-tool">
              <p class="phone-tool-label">Scam message checker</p>
              <textarea id="scam-input" rows="2">Il tuo conto e bloccato. Invia subito il codice OTP per sbloccarlo.</textarea>
              <button class="phone-tool-run" type="button" id="scam-run">Check message</button>
              <p class="phone-tool-output" id="scam-output" aria-live="polite"></p>
            </div>
          )}

          {mod.id === 'family' && (
            <Fragment>
              <div class="phone-tool">
                <p class="phone-tool-label">Caregiver pairing code</p>
                <button class="phone-tool-run" type="button" id="pairing-run">Generate pairing code</button>
                <p class="phone-tool-output" id="pairing-output" aria-live="polite"></p>
              </div>
              <div class="phone-tool">
                <p class="phone-tool-label">Today's status</p>
                <div class="phone-tool-row">
                  <button class="phone-tool-run" type="button" id="status-ok-run">All ok</button>
                  <button class="phone-tool-run secondary" type="button" id="status-attention-run">Needs attention</button>
                </div>
                <p class="phone-tool-output" id="status-output" aria-live="polite">No status set for today yet</p>
              </div>
            </Fragment>
          )}

          {mod.id === 'speech' && (
            <div class="phone-tool">
              <p class="phone-tool-label">Phrase board</p>
              <div class="phone-chip-row" id="phrase-chips" aria-label="Quick phrases"></div>
              <p class="phone-tool-note">Tapping a phrase records its use and adds it to the sentence below; the top suggestions rank phrases by how recently and often they were used.</p>
              <p class="phone-tool-output" id="phrase-output" aria-live="polite">No phrase used yet.</p>
              <div class="phone-tool-row">
                <button class="phone-tool-run" type="button" id="sentence-build-run">Build sentence</button>
                <button class="phone-tool-run secondary" type="button" id="sentence-clear-run">Clear</button>
              </div>
              <p class="phone-tool-output" id="sentence-output" aria-live="polite">No phrase selected yet.</p>
            </div>
          )}

          {mod.id === 'reading' && (
            <Fragment>
              <div class="phone-tool">
                <p class="phone-tool-label">Syllable splitter</p>
                <textarea id="syllable-input" rows="1">patria</textarea>
                <button class="phone-tool-run" type="button" id="syllable-run">Split into syllables</button>
                <p class="phone-tool-output" id="syllable-output" aria-live="polite"></p>
              </div>
              <div class="phone-tool">
                <p class="phone-tool-label">Flashcard review</p>
                <p class="phone-flashcard">What is the capital of Italy?</p>
                <p class="phone-tool-note">Rate how well you recalled it; the schedule below follows the SM-2 algorithm.</p>
                <div class="phone-chip-row" id="flashcard-buttons" aria-label="Recall quality, 0 to 5"></div>
                <p class="phone-tool-output" id="flashcard-output" aria-live="polite">Not reviewed yet.</p>
              </div>
            </Fragment>
          )}

          {mod.id === 'memory' && (
            <Fragment>
              <div class="phone-tool">
                <p class="phone-tool-label">Add a person</p>
                <input id="person-name" type="text" placeholder="Name" value="Maria" />
                <input id="person-relationship" type="text" placeholder="Relationship" value="daughter" />
                <label class="phone-checkbox-row">
                  <input id="person-consent" type="checkbox" />
                  Consent to future on-device recognition
                </label>
                <button class="phone-tool-run" type="button" id="person-run">Add person</button>
                <p class="phone-tool-output" id="person-output" aria-live="polite">No one added yet.</p>
              </div>
              <div class="phone-tool">
                <p class="phone-tool-label">Add a reminder</p>
                <input id="reminder-title" type="text" placeholder="Reminder" value="Take medicine" />
                <div class="phone-tool-row">
                  <input id="reminder-minutes" type="number" min="0" value="0" aria-label="Minutes from now" />
                  <select id="reminder-recurrence" aria-label="Recurrence">
                    <option value="none">One time</option>
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                  </select>
                </div>
                <button class="phone-tool-run" type="button" id="reminder-run">Add reminder</button>
                <p class="phone-tool-output" id="reminder-output" aria-live="polite">No reminders due.</p>
              </div>
            </Fragment>
          )}

          {mod.id === 'mobility' && (
            <div class="phone-tool">
              <p class="phone-tool-label">Gait stability monitor</p>
              <p class="phone-tool-note">Simulates a window of accelerometer samples, since there is no live sensor in a browser.</p>
              <div class="phone-tool-row">
                <button class="phone-tool-run" type="button" id="gait-steady-run">Simulate steady walk</button>
                <button class="phone-tool-run secondary" type="button" id="gait-unsteady-run">Simulate unsteady walk</button>
              </div>
              <p class="phone-tool-output" id="gait-output" aria-live="polite"></p>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="phone-home-indicator" aria-hidden="true"></div>
  </div>
</div>
