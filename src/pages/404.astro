---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page does not exist.">
  <div class="not-found">
    <p class="code-num" aria-hidden="true">404</p>
    <h1>This page is dark</h1>
    <p class="lead" style="margin-left: auto; margin-right: auto">
      The page you were looking for does not exist, or it moved. Here are some places to start.
    </p>
    <div class="cta-row" style="justify-content: center">
      <a class="button primary" href="/">Go home</a>
      <a class="button secondary" href="/modules/">Modules</a>
      <a class="button secondary" href="/docs/">Documentation</a>
    </div>
  </div>
</Layout>
