---
import Layout from '../../../layouts/Layout.astro';
import { modules } from '../../../data/modules';
---

<Layout
  title="Modules"
  description="Lumen's eight modules: which ones exist already and which are planned."
  lang="en"
  altHref="/moduli/"
>
  <div class="hero">
    <h1>Modules</h1>
    <p class="lead">
      Lumen is made of eight independent modules, all built on the same senses engine. Not all of
      them have been built yet: here is the real status of each one.
    </p>
  </div>

  <section class="wide">
    <ul class="module-list">
      {modules.map((mod) => (
        <li>
          <div class="module-head">
            <h3>{mod.nameEn}</h3>
            {mod.repoUrl ? (
              <span class="status available">Repository available</span>
            ) : (
              <span class="status planned">Planned</span>
            )}
          </div>
          <p>{mod.descriptionEn}</p>
          {mod.repoUrl && <p><a href={mod.repoUrl}>{mod.repoLabel}</a></p>}
        </li>
      ))}
    </ul>

    <p>
      Modules marked "Planned" have no code yet: they are added as a package in
      <a href="https://github.com/lumen-assistive/lumen-plugins">lumen-plugins</a> once their
      development phase starts, per the project's public roadmap. Want to contribute one? See the
      <a href="/docs/contributing/plugins/">guide to building a plugin</a>.
    </p>
  </section>
</Layout>
