---
import Layout from '../layouts/Layout.astro';
import { MODULE_COLORS, MODULE_ICONS } from '../lib/moduleVisuals';

const modules = [
  {
    id: 'vision',
    name: 'Vision',
    text: 'Reads expiry dates, names colors, and checks text contrast.',
  },
  {
    id: 'hearing',
    name: 'Hearing',
    text: 'Summarizes transcripts, formats captions, and presents sound alerts.',
  },
  {
    id: 'safety',
    name: 'Safety',
    text: 'Flags scam messages, detects falls, and runs a cancellable SOS countdown.',
  },
  {
    id: 'family',
    name: 'Family',
    text: 'Pairing codes, a shared calendar, and a daily status for caregivers.',
  },
  {
    id: 'speech',
    name: 'Speech',
    text: 'A quick phrase board that ranks suggestions by how it is used.',
  },
  {
    id: 'reading',
    name: 'Reading',
    text: 'Splits words into syllables and schedules flashcard reviews.',
  },
  {
    id: 'memory',
    name: 'Memory',
    text: 'Contacts that require consent, and recurring reminders.',
  },
  {
    id: 'mobility',
    name: 'Mobility',
    text: 'Checks how steady a walk is and keeps a mobility profile.',
  },
];

const audiences = [
  {
    title: 'Low vision',
    text: 'Maximum contrast, the largest text, and big controls. Spoken interaction arrives once the native bridges exist.',
    icon: '<ellipse cx="12" cy="12" rx="9" ry="5.5"/><circle cx="12" cy="12" r="2.1" fill="currentColor" stroke="none"/>',
  },
  {
    title: 'Deaf or hard of hearing',
    text: 'A fully visual interface, with vibration standing in for audio cues.',
    icon: '<line x1="7" y1="15" x2="7" y2="9"/><line x1="12" y1="17" x2="12" y2="6"/><line x1="17" y1="15" x2="17" y2="10"/>',
  },
  {
    title: 'Older adults',
    text: 'A reduced, essential layout with fewer choices and larger text.',
    icon: '<circle cx="12" cy="12" r="8.3"/><line x1="12" y1="12" x2="12" y2="7.4"/><line x1="12" y1="12" x2="15.1" y2="13.9"/>',
  },
  {
    title: 'Students and everyone else',
    text: 'The complete layout with every option on screen.',
    icon: '<path d="M12 6.8c-2.3-1.6-4.9-2-8.3-1.3v12.3c3.4-0.7 6 -0.3 8.3 1.3 2.3-1.6 4.9-2 8.3-1.3V5.5c-3.4-0.7-6-0.3-8.3 1.3z"/><line x1="12" y1="6.8" x2="12" y2="19.1"/>',
  },
];

const showcase = [
  { id: 'onboarding', name: 'Onboarding', color: '#f2b138' },
  { id: 'home', name: 'Home', color: '#f2b138' },
  { id: 'protezione', name: 'Safety', color: MODULE_COLORS.safety },
  { id: 'parlare', name: 'Speech', color: MODULE_COLORS.speech },
];

const privacyPoints = [
  {
    title: 'On the phone',
    text: 'Every essential feature runs on the device, with no network connection needed.',
    icon: '<rect x="7" y="3" width="10" height="18" rx="2.5"/><line x1="11" y1="18" x2="13" y2="18"/>',
  },
  {
    title: 'Consent first',
    text: 'Sharing with a family member or caregiver needs explicit consent that can be revoked at any time.',
    icon: '<path d="M12 3.4l6.4 2.3v5.2c0 4.5-2.7 7.6-6.4 8.9-3.7-1.3-6.4-4.4-6.4-8.9V5.7z"/><path d="M9 12l2.2 2.2L15.2 10"/>',
  },
  {
    title: 'Sync stays sealed',
    text: 'An optional server stores only data that is encrypted before it leaves the phone, so it cannot read it.',
    icon: '<rect x="5" y="10.5" width="14" height="9.5" rx="2.5"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>',
  },
];
---

<Layout
  title="Lumen"
  description="Lumen is an open source, offline-first, privacy-by-design assistant for people with a limitation."
>
  <div class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <h1 class="hero-enter" style="animation-delay: 60ms">A little light, when it's needed.</h1>
    <p class="lead hero-enter" style="animation-delay: 220ms">
      Lumen turns a smartphone into help for people with a limitation in seeing, hearing, speaking,
      reading, remembering, moving, or staying safe. Everything runs on the phone, no internet
      required.
    </p>
    <div class="cta-row hero-enter" style="animation-delay: 380ms">
      <a class="button primary" href="/modules/">Discover the modules</a>
      <a class="button secondary" href="/demo/">Try the demo</a>
      <a class="button secondary" href="/screenshots/">See screenshots</a>
    </div>
    <ul class="fact-row hero-enter" style="animation-delay: 520ms">
      <li>Open source, Apache-2.0</li>
      <li>Offline-first</li>
      <li>Privacy by design</li>
      <li>Eight modules</li>
    </ul>
  </div>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">Eight modules, one engine</p>
      <h2>Help for the things that get in the way</h2>
      <p>
        A single shared "senses engine" (vision, audio, text) powers eight independent modules,
        delivered as plugins. Each module's logic is implemented and tested; live camera,
        microphone, and sensor input is the next step.
      </p>
    </div>
    <div class="module-grid">
      {modules.map((mod) => (
        <article class="module-card" style={`--module-color: ${MODULE_COLORS[mod.id]}`}>
          <span
            class="module-icon"
            aria-hidden="true"
            set:html={`<svg viewBox="0 0 24 24">${MODULE_ICONS[mod.id]}</svg>`}
          />
          <h3><a href={`/docs/app/modules/${mod.id}/`}>{mod.name}</a></h3>
          <p>{mod.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">Adapts to who uses it</p>
      <h2>Five questions, then the right app</h2>
      <p>
        On first launch Lumen asks five short questions. The answers turn on only the modules a
        person needs and decide how the interface behaves.
      </p>
    </div>
    <div class="card-grid cols-4">
      {audiences.map((item) => (
        <div class="info-card">
          <span class="card-icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24">${item.icon}</svg>`} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
    <p style="margin-top: 1.25rem">
      <a href="/docs/app/ui-modes/">How the interface modes work</a>
    </p>
  </section>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>Simple on the surface</h2>
    </div>
    <ol class="steps">
      <li>
        <h3>Answer five questions</h3>
        <p>Four are yes or no, the last chooses a simple or a complete interface.</p>
      </li>
      <li>
        <h3>Get only what you need</h3>
        <p>Lumen enables the matching modules and sets the contrast, text size, and layout.</p>
      </li>
      <li>
        <h3>Use it on the phone</h3>
        <p>Every tool runs on the device. Change modules, consent, and text size in settings.</p>
      </li>
    </ol>
  </section>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">The real app</p>
      <h2>Screens rendered from the actual code</h2>
      <p>
        These are not mockups. Each image is the app's own widget tree, rendered by a test and
        saved as a picture.
      </p>
    </div>
    <div class="showcase">
      {showcase.map((shot) => (
        <figure class="screenshot-card" style={`--shot-color: ${shot.color}`}>
          <div class="screenshot-phone">
            <img src={`/screenshots/${shot.id}.png`} alt={`${shot.name} screen of the Lumen app`} loading="lazy" />
          </div>
          <figcaption>
            <span class="screenshot-name">{shot.name}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p style="margin-top: 1.5rem"><a href="/screenshots/">See every screen</a></p>
  </section>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">Privacy by design</p>
      <h2>Stays on the phone</h2>
      <p>
        No audio or image ever leaves the device unless the person explicitly chooses to share it.
      </p>
    </div>
    <div class="card-grid">
      {privacyPoints.map((item) => (
        <div class="info-card">
          <span class="card-icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24">${item.icon}</svg>`} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
    <p style="margin-top: 1.25rem"><a href="/privacy/">Read the privacy page</a></p>
  </section>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">For developers</p>
      <h2>Build a module without touching the engine</h2>
      <p>
        Every official module is a plugin that follows a public SDK: a lifecycle, a typed event
        bus, and a model registry. A contributor can write a new one the same way, as a pull
        request.
      </p>
    </div>
    <div class="cta-row">
      <a class="button primary" href="/sdk/">Explore the SDK</a>
      <a class="button secondary" href="/docs/contributing/plugins/">Guide to building a plugin</a>
      <a class="button secondary" href="/docs/">Read the docs</a>
    </div>
  </section>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">Project status</p>
      <h2>Honest about where it stands</h2>
      <p>
        Lumen is built for the GF Marilli Prize by HackersGen, in active open source development.
        No user data, metrics, or partnerships are published until they are real and verifiable.
      </p>
    </div>
    <div class="status-grid">
      <div class="status-card">
        <h3>Working today</h3>
        <ul>
          <li>All eight modules' logic, with automated tests</li>
          <li>An app with onboarding, a screen per module, and settings</li>
          <li>The plugin SDK and the senses engine</li>
          <li>An optional sync server that stores only opaque, encrypted data</li>
          <li>A full documentation wiki</li>
        </ul>
      </div>
      <div class="status-card pending">
        <h3>Not there yet</h3>
        <ul>
          <li>Live camera, microphone, and sensor input</li>
          <li>On-device models</li>
          <li>A signed Android release</li>
          <li>Manual screen reader testing</li>
          <li>Real user testing results</li>
        </ul>
      </div>
    </div>
    <p style="margin-top: 1.25rem">
      <a href="/docs/introduction/status/">Full project status</a> and <a href="/docs/introduction/roadmap/">roadmap</a>
    </p>
  </section>

  <section class="band">
    <div class="section-head">
      <p class="eyebrow">Frequently asked</p>
      <h2>Quick answers</h2>
    </div>
    <div class="faq-list">
      <details class="faq-item">
        <summary>Is there an app I can install?</summary>
        <p>
          Not yet. <code>lumen-app</code> exists and runs, but there is no signed Android release. See <a href="/download/">Download</a>.
        </p>
      </details>
      <details class="faq-item">
        <summary>Does anything I say or that Lumen sees leave my phone?</summary>
        <p>
          No, not by default. Every essential feature runs on-device. The only exceptions are
          features you explicitly turn on and consent to, like sharing status with a caregiver or
          syncing with the optional server, and in those cases what is sent is end-to-end
          encrypted. See <a href="/docs/privacy/data-handling/">Data handling in detail</a>.
        </p>
      </details>
      <details class="faq-item">
        <summary>Why don't the modules use the camera, microphone, or accelerometer yet?</summary>
        <p>
          Because <code>lumen-core</code> has no native sensor bridges yet. Every module's real,
          tested business logic (parsing, detection algorithms, state machines) is implemented and
          ready; it is simply not connected to live hardware yet. See <a href="/docs/introduction/architecture/">Architecture overview</a>.
        </p>
      </details>
      <details class="faq-item">
        <summary>What license is the code under?</summary>
        <p>
          Apache License 2.0, in every repository. Third-party models and datasets are licensed
          separately and tracked in <a href="https://github.com/lumen-assistive/lumen-models">lumen-models</a>. See <a href="/docs/privacy/licensing/">Model and dataset licensing</a>.
        </p>
      </details>
    </div>
    <p style="margin-top: 1.25rem"><a href="/docs/reference/faq/">See the full FAQ</a></p>
  </section>

  <section class="band">
    <div class="cta-panel">
      <h2>Follow along, or help build it.</h2>
      <p>
        Lumen is open source from the first commit. Read the code, try the demo, or send a pull
        request.
      </p>
      <div class="cta-row">
        <a class="button primary" href="https://github.com/lumen-assistive">View on GitHub</a>
        <a class="button secondary" href="/demo/">Try the demo</a>
      </div>
    </div>
  </section>
</Layout>
